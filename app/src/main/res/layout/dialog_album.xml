<?xml version="1.0" encoding="utf-8"?>
<com.hjq.shape.layout.ShapeConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:tools="http://schemas.android.com/tools"
    android:gravity="center"
    android:orientation="vertical"
    app:shape_radiusInTopLeft="@dimen/dp_20"
    app:shape_radiusInTopRight="@dimen/dp_20"
    app:shape_solidColor="@color/color_202020">




    <TextView
        android:id="@+id/tv_title"
        style="@style/TextAppearance.App.Bold"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/dp_10"
        android:layout_marginTop="@dimen/dp_10"
        android:gravity="center"
        android:text="Secret Shared Media"
        android:textColor="@color/white"
        android:textSize="@dimen/sp_18"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/tv_content"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/dp_10"
        android:layout_marginTop="@dimen/dp_10"
        android:gravity="center"
        android:text="Exchange confidential photos and videos securely. Content self-destructs."
        android:textColor="@color/white"
        android:textSize="@dimen/sp_14"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_title" />



    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginVertical="@dimen/dp_10"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginHorizontal="@dimen/dp_7"
        tools:itemCount="3"
        tools:listitem="@layout/item_album"
        app:layout_constraintBottom_toTopOf="@+id/stv_confirm"
        app:layout_constraintTop_toBottomOf="@+id/tv_content" />



    <com.hjq.shape.view.ShapeTextView
        android:id="@+id/stv_delete"
        style="@style/TextAppearance.App.Bold"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/dp_10"
        android:layout_marginBottom="@dimen/dp_15"
        android:gravity="center"
        android:paddingVertical="@dimen/dp_15"
        android:text="Delete"
        android:textColor="@color/color_999999"
        android:textSize="@dimen/sp_16"


        app:layout_constraintEnd_toStartOf="@+id/stv_confirm"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:shape_radius="@dimen/dp_10"
        app:shape_solidPressedColor="@color/pressedColor"
        app:shape_strokeColor="@color/color_999999"
        app:shape_strokeSize="@dimen/dp_1" />

    <com.hjq.shape.view.ShapeTextView
        android:id="@+id/stv_confirm"
        style="@style/TextAppearance.App.Bold"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/dp_10"
        android:layout_marginBottom="@dimen/dp_15"
        android:gravity="center"
        android:paddingVertical="@dimen/dp_15"
        android:text="Send"
        android:textColor="@color/white"
        android:textSize="@dimen/sp_16"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/stv_delete"
        app:shape_radius="@dimen/dp_10"
        app:shape_solidColor="@color/endColor"
        app:shape_solidPressedColor="@color/pressedColor" />

    <ImageView
        android:id="@+id/iv_close"
        android:layout_width="@dimen/dp_40"
        android:layout_height="@dimen/dp_40"
        android:padding="@dimen/dp_5"
        android:src="@drawable/iv_close"
        android:layout_marginEnd="@dimen/dp_5"
        android:layout_marginTop="@dimen/dp_5"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

</com.hjq.shape.layout.ShapeConstraintLayout>