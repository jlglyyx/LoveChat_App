<?xml version="1.0" encoding="utf-8"?>
<com.hjq.shape.layout.ShapeConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    app:shape_radiusInTopLeft="@dimen/dp_20"
    app:shape_radiusInTopRight="@dimen/dp_20"
    android:orientation="vertical"
    android:gravity="center"
    app:shape_solidColor="@color/color_202020">



    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:paddingHorizontal="@dimen/dp_25"
        android:paddingBottom="@dimen/dp_10"
        android:paddingTop="@dimen/dp_25">

    <TextView
        android:id="@+id/tv_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        style="@style/TextAppearance.App.Bold"
        android:text="Date of Birth"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:textColor="@color/white"
        android:textSize="@dimen/sp_20" />

    <TextView
        android:id="@+id/tv_age"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_20"
        android:text="You're 0 years old"
        android:gravity="center"
        android:textStyle="bold"
        app:layout_constraintTop_toBottomOf="@+id/tv_title"
        android:textColor="@color/white"
        android:textSize="@dimen/sp_14" />

    <LinearLayout
        app:layout_constraintTop_toBottomOf="@+id/tv_age"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="180dp"
        android:layout_marginTop="@dimen/dp_20"
        android:id="@+id/ll_birth"
        android:gravity="center">

        <com.yang.lovechat.widget.TimePickView
            android:layout_width="0dp"
            android:layout_weight="1"
            android:id="@+id/mTimePickView"
            android:layout_height="match_parent" />

    </LinearLayout>


        <ImageView
            android:id="@+id/tv_cancel"
            android:layout_width="@dimen/dp_32"
            android:layout_height="@dimen/dp_32"
            android:padding="@dimen/dp_2"
            android:src="@drawable/iv_close"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />


        <com.hjq.shape.view.ShapeTextView
            android:id="@+id/tv_commit"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:enabled="false"
            android:gravity="center"
            android:paddingVertical="@dimen/dp_15"
            android:text="Save"
            android:textColor="@color/white"
            android:textSize="@dimen/sp_16"
            style="@style/TextAppearance.App.Bold"
            android:layout_marginTop="@dimen/dp_20"
            app:layout_constraintTop_toBottomOf="@+id/ll_birth"
            app:shape_radius="@dimen/dp_10"
            app:layout_constraintStart_toStartOf="@+id/ll_birth"
            app:layout_constraintEnd_toEndOf="@+id/ll_birth"
            app:shape_solidColor="@color/endColor"
            app:shape_textDisabledColor="@color/white"
            app:shape_solidDisabledColor="@color/color_D9D9D9"
            app:shape_solidPressedColor="@color/pressedColor" />


    </androidx.constraintlayout.widget.ConstraintLayout>
</com.hjq.shape.layout.ShapeConstraintLayout>