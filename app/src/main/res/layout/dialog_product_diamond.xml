<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/black"
    android:gravity="center"
    android:orientation="vertical">


    <TextView
        android:id="@+id/tv_1"
        style="@style/TextAppearance.App.Bold"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="Diamond"
        android:layout_marginTop="@dimen/dp_20"
        android:textColor="@color/white"
        android:textSize="@dimen/sp_20"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <ImageView
        android:id="@+id/iv_close"
        android:layout_width="@dimen/dp_40"
        android:layout_height="@dimen/dp_40"
        android:layout_gravity="start"
        android:padding="@dimen/dp_5"
        android:layout_marginTop="@dimen/dp_20"
        android:src="@drawable/iv_close"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />




    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerView"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:clipToPadding="false"
        android:overScrollMode="never"
        android:layout_marginStart="@dimen/dp_15"
        android:layout_marginEnd="@dimen/dp_10"
        android:layout_marginTop="@dimen/dp_20"
        app:layout_constraintTop_toBottomOf="@+id/tv_1"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        tools:itemCount="6"
        app:spanCount="2"
        tools:layoutManager="androidx.recyclerview.widget.GridLayoutManager"
        tools:listitem="@layout/item_product_diamond"
        tools:orientation="horizontal" />



    <TextView
        android:id="@+id/tv_balance"
        style="@style/TextAppearance.App.Bold"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/dp_15"
        android:layout_marginTop="@dimen/dp_7"
        android:gravity="center"
        android:textColor="@color/color_999999"
        android:textSize="@dimen/sp_12"
        android:visibility="visible"
        app:layout_constraintTop_toBottomOf="@+id/recyclerView"
        tools:text="Balance:20" />

    <com.hjq.shape.view.ShapeTextView
        android:id="@+id/stv_next"
        style="@style/TextAppearance.App.Bold"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/dp_15"
        android:layout_marginTop="@dimen/dp_12"
        android:layout_marginBottom="@dimen/dp_15"
        app:layout_constraintBottom_toBottomOf="parent"
        android:gravity="center"
        android:paddingVertical="@dimen/dp_15"
        android:text="Get Diamond"
        android:textColor="@color/white"
        android:textSize="@dimen/sp_16"
        app:layout_constraintTop_toBottomOf="@+id/tv_balance"
        app:shape_radius="@dimen/dp_30"
        app:shape_solidColor="@color/black"
        app:shape_solidGradientStartColor="@color/startColor"
        app:shape_solidGradientEndColor="@color/endColor"
        app:shape_solidPressedColor="@color/pressedColor" />


</androidx.constraintlayout.widget.ConstraintLayout>
