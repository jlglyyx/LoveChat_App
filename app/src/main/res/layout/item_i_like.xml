<?xml version="1.0" encoding="utf-8"?>
<com.hjq.shape.layout.ShapeConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/scl_container"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginEnd="@dimen/dp_8"
    android:layout_marginBottom="@dimen/dp_8"
    app:shape_radius="@dimen/dp_5">


    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/iv_image"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:scaleType="centerCrop"
        app:layout_constraintDimensionRatio="1:1.5"
        app:shapeAppearance="@style/RadiusStyle_5"
        tools:layout_editor_absoluteX="0dp"
        tools:layout_editor_absoluteY="0dp" />


    <com.hjq.shape.view.ShapeView
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHeight_percent="0.1"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:shape_radiusInTopLeft="@dimen/dp_5"
        app:shape_radiusInTopRight="@dimen/dp_5"
        app:shape_solidGradientEndColor="@color/black_50"
        app:shape_solidGradientOrientation="bottomToTop"
        app:shape_solidGradientStartColor="@color/transparent" />


    <com.hjq.shape.view.ShapeView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_gravity="bottom"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHeight_percent="0.2"
        app:layout_constraintStart_toStartOf="parent"
        app:shape_radiusInBottomLeft="@dimen/dp_5"
        app:shape_radiusInBottomRight="@dimen/dp_5"
        app:shape_solidGradientCenterColor="@color/black_50"
        app:shape_solidGradientEndColor="@color/black"
        app:shape_solidGradientOrientation="topToBottom"
        app:shape_solidGradientStartColor="@color/transparent" />


    <com.hjq.shape.layout.ShapeLinearLayout
        android:id="@+id/sll_online"
        android:layout_marginStart="@dimen/dp_5"
        android:layout_marginTop="@dimen/dp_5"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="@dimen/dp_5"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="@dimen/dp_5"
        android:paddingVertical="@dimen/dp_3"
        app:layout_constraintTop_toTopOf="@+id/iv_image"
        app:layout_constraintEnd_toEndOf="@+id/iv_image"
        app:shape_radius="@dimen/dp_13"
        app:shape_solidColor="@color/black_50"
        app:shape_strokeSize="@dimen/dp_1">

        <com.hjq.shape.view.ShapeView
            android:id="@+id/sv_online"
            android:layout_width="5dp"
            android:layout_height="5dp"
            app:shape_radius="@dimen/dp_10"
            app:shape_solidColor="@color/onlineColor" />

        <TextView
            android:id="@+id/tv_online"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/dp_3"
            android:text="Online"
            android:textColor="@color/white"
            android:textSize="@dimen/sp_10" />


    </com.hjq.shape.layout.ShapeLinearLayout>




    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/dp_5"
        android:layout_marginBottom="@dimen/dp_5"
        android:orientation="vertical"
        android:id="@+id/ll_container"
        app:layout_constraintBottom_toBottomOf="@id/iv_image"
        app:layout_constraintStart_toStartOf="@id/iv_image">

        <com.hjq.shape.layout.ShapeLinearLayout
            android:id="@+id/sll_location"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            app:shape_radius="@dimen/dp_13"
            app:shape_solidColor="@color/transparent"
            app:shape_strokeSize="@dimen/dp_1">

            <ImageView
                android:id="@+id/sv_location"
                android:layout_width="10dp"
                android:layout_height="10dp"
                android:src="@drawable/iv_location"
                app:tint="@color/white" />

            <TextView
                android:id="@+id/tv_location"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/dp_3"
                android:textColor="@color/white"
                android:textSize="@dimen/sp_10" />


        </com.hjq.shape.layout.ShapeLinearLayout>



    </LinearLayout>



    <TextView
        android:id="@+id/tv_name"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/dp_5"
        android:ellipsize="middle"
        android:singleLine="true"
        android:textColor="@color/white"
        android:textSize="@dimen/sp_16"
        style="@style/TextAppearance.App.Bold"
        app:layout_constraintEnd_toStartOf="@+id/iv_connect"
        android:layout_marginBottom="@dimen/dp_3"
        app:layout_constraintBottom_toTopOf="@+id/ll_container"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />



    <ImageView
        android:id="@+id/iv_connect"
        android:layout_width="@dimen/dp_40"
        android:layout_height="@dimen/dp_40"
        android:src="@drawable/iv_connect"
        android:layout_marginBottom="@dimen/dp_5"
        android:layout_marginEnd="@dimen/dp_5"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent" />




</com.hjq.shape.layout.ShapeConstraintLayout>

