<?xml version="1.0" encoding="utf-8"?>
<com.hjq.shape.layout.ShapeConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:tool="http://schemas.android.com/tools"
    android:gravity="center"
    android:orientation="vertical"
    app:shape_radiusInTopLeft="@dimen/dp_20"
    app:shape_radiusInTopRight="@dimen/dp_20"
    app:shape_solidColor="@color/color_202020">


    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:paddingHorizontal="@dimen/dp_25"
        android:paddingTop="@dimen/dp_25"
        android:paddingBottom="@dimen/dp_10">

        <TextView
            android:id="@+id/tv_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            style="@style/TextAppearance.App.Bold"
            android:textColor="@color/white"
            android:textSize="@dimen/sp_20"
            tool:text="Title"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />


        <LinearLayout
            android:id="@+id/ll_wheel"
            android:layout_width="match_parent"
            android:layout_height="180dp"
            android:gravity="center"
            android:layout_marginTop="@dimen/dp_10"
            android:orientation="horizontal"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tv_close">

            <com.contrarywind.view.WheelView
                android:id="@+id/wheel_item"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1" />

        </LinearLayout>


        <ImageView
            android:id="@+id/tv_close"
            android:layout_width="@dimen/dp_32"
            android:layout_height="@dimen/dp_32"
            android:padding="@dimen/dp_2"
            android:src="@drawable/iv_close"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />




        <com.hjq.shape.view.ShapeTextView
            android:id="@+id/tv_save"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:enabled="false"
            android:gravity="center"
            android:paddingVertical="@dimen/dp_15"
            android:text="Save"
            android:textColor="@color/white"
            android:textSize="@dimen/sp_16"
            style="@style/TextAppearance.App.Bold"
            android:layout_marginTop="@dimen/dp_20"
            app:layout_constraintTop_toBottomOf="@+id/ll_wheel"
            app:shape_radius="@dimen/dp_10"
            app:shape_textDisabledColor="@color/white"
            app:shape_solidDisabledColor="@color/color_D9D9D9"
            app:layout_constraintStart_toStartOf="@+id/ll_wheel"
            app:layout_constraintEnd_toEndOf="@+id/ll_wheel"
            app:shape_solidColor="@color/endColor"
            app:shape_solidPressedColor="@color/pressedColor" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</com.hjq.shape.layout.ShapeConstraintLayout>