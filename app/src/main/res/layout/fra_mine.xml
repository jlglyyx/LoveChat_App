<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tool="http://schemas.android.com/tools"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <TextView
        android:id="@+id/tv_logo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:paddingStart="@dimen/dp_10"
        android:text="Me"
        android:textColor="@color/white"
        android:textSize="@dimen/sp_25"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />






    <ImageView
        android:id="@+id/iv_setting"
        android:layout_width="@dimen/dp_35"
        android:layout_height="0dp"
        android:paddingEnd="@dimen/dp_10"
        android:layout_marginEnd="@dimen/dp_2"
        android:src="@drawable/iv_setting"
        app:layout_constraintBottom_toBottomOf="@+id/tv_logo"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/tv_logo" />


    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_0"
        app:layout_constraintBottom_toBottomOf="parent"

        app:layout_constraintTop_toBottomOf="@+id/tv_logo">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingBottom="@dimen/dp_30">


            <View
                android:id="@+id/view_edit"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                app:layout_constraintTop_toTopOf="@+id/iv_avatar"
                app:layout_constraintBottom_toBottomOf="@+id/iv_avatar"/>

            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/iv_avatar"
                android:layout_width="@dimen/dp_100"
                android:layout_height="@dimen/dp_0"
                android:layout_marginStart="@dimen/dp_10"
                android:layout_marginTop="@dimen/dp_15"
                android:padding="@dimen/dp_2"
                android:scaleType="centerCrop"
                app:layout_constraintDimensionRatio="1:1"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:shapeAppearance="@style/circleStyle"
                app:strokeColor="@color/transparent"
                app:strokeWidth="@dimen/dp_2" />

            <ImageView
                android:layout_width="@dimen/dp_30"
                android:layout_height="@dimen/dp_30"
                android:padding="@dimen/dp_3"
                android:layout_marginEnd="@dimen/dp_10"
                android:layout_weight="1"
                android:id="@+id/iv_edit_info"
                android:src="@drawable/iv_edit_info"
                app:layout_constraintBottom_toBottomOf="@+id/iv_avatar"
                app:layout_constraintEnd_toEndOf="@+id/iv_avatar" />


            <TextView
                android:id="@+id/tv_name"
                style="@style/TextAppearance.App.Bold"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/dp_8"
                android:layout_marginTop="@dimen/dp_20"
                android:layout_marginEnd="@dimen/dp_50"
                android:maxLines="2"
                android:textStyle="bold"
                android:textColor="@color/white"
                android:textSize="@dimen/sp_20"
                app:layout_constrainedWidth="true"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="0"
                app:layout_constraintStart_toEndOf="@+id/iv_avatar"
                app:layout_constraintTop_toTopOf="@+id/iv_avatar"
                tool:text="DoNaDoNaDoNaDoNaDoNaDoNaDoNaDoNaDoNaDoNaDoNaDoNa" />

            <ImageView
                android:layout_width="@dimen/dp_20"
                android:layout_height="@dimen/dp_20"
                android:layout_marginStart="@dimen/dp_5"
                android:visibility="gone"
                android:src="@drawable/iv_crown"
                android:id="@+id/iv_vip_tag"
                app:layout_constraintBottom_toBottomOf="@+id/tv_name"
                app:layout_constraintStart_toEndOf="@+id/tv_name"
                app:layout_constraintTop_toTopOf="@+id/tv_name" />


            <TextView
                android:id="@+id/tv_id"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/white"
                android:textSize="@dimen/sp_14"
                android:visibility="gone"
                android:layout_marginTop="@dimen/dp_8"
                app:layout_constraintStart_toStartOf="@+id/tv_name"
                app:layout_constraintTop_toBottomOf="@+id/tv_name"
                tool:text="ID:15121212" />


            <com.hjq.shape.layout.ShapeConstraintLayout
                android:id="@+id/scl_diamond"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_5"
                android:paddingEnd="@dimen/dp_20"
                android:paddingVertical="@dimen/dp_8"
                app:layout_constraintStart_toStartOf="@+id/tv_name"
                app:layout_constraintTop_toBottomOf="@+id/tv_name"
                app:layout_goneMarginTop="@dimen/dp_15"
                app:shape_radius="@dimen/dp_10">

                <ImageView
                    android:id="@+id/iv_0"
                    android:layout_width="@dimen/dp_20"
                    android:layout_height="@dimen/dp_20"
                    android:layout_weight="1"
                    android:src="@drawable/iv_diamond"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />



                <TextView
                    android:id="@+id/tv_diamond"
                    style="@style/TextAppearance.App.Bold"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/dp_5"
                    android:text="0"
                    android:textColor="@color/white"
                    android:textSize="@dimen/sp_18"
                    app:layout_constraintStart_toEndOf="@+id/iv_0"
                    app:layout_constraintTop_toTopOf="@+id/iv_0"
                    app:layout_constraintBottom_toBottomOf="@+id/iv_0"/>


                <ImageView
                    android:layout_width="@dimen/dp_20"
                    android:layout_height="@dimen/dp_20"
                    android:visibility="gone"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toEndOf="@+id/tv_diamond"
                    app:layout_constraintTop_toTopOf="parent"
                    android:src="@drawable/iv_into"
           />

            </com.hjq.shape.layout.ShapeConstraintLayout>


            <com.yang.lovechat.widget.InterceptConstraintLayout
                android:id="@+id/scl_vip_desc"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/dp_10"
                android:layout_marginTop="@dimen/dp_15"
                app:layout_constraintTop_toBottomOf="@+id/iv_avatar"
                app:shape_radius="@dimen/dp_10"
                app:shape_solidColor="@color/color_222222"
                app:shape_solidGradientEndColor="@color/endColor"
                app:shape_solidGradientStartColor="@color/color_gold_bg">


                <TextView
                    android:id="@+id/tv_title"
                    style="@style/TextAppearance.App.Bold"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/dp_5"
                    android:layout_marginTop="@dimen/dp_5"
                    android:text="Upgrade to Pulse"
                    android:textColor="@color/color_gold"
                    android:textSize="@dimen/sp_17"
                    android:textStyle="bold"
                    app:layout_constraintStart_toEndOf="@+id/iv_1"
                    app:layout_constraintTop_toTopOf="parent" />

                <TextView
                    android:id="@+id/tv_expired_time"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Unlock all features and get more matches!"
                    android:textColor="@color/white"
                    android:textSize="@dimen/sp_12"
                    android:layout_marginTop="@dimen/dp_2"
                    app:layout_constraintStart_toStartOf="@+id/tv_title"
                    app:layout_constraintTop_toBottomOf="@+id/tv_title" />


                <ImageView
                    android:id="@+id/iv_1"
                    android:layout_width="@dimen/dp_50"
                    android:layout_height="@dimen/dp_50"
                    android:layout_marginEnd="@dimen/dp_8"
                    android:src="@drawable/iv_crown"
                    android:padding="@dimen/dp_5"
                    android:layout_marginStart="@dimen/dp_6"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <com.hjq.shape.layout.ShapeLinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginTop="@dimen/dp_5"
                    app:layout_constraintTop_toBottomOf="@+id/iv_1"
                    app:shape_solidColor="@color/color_222222"
                    app:shape_radiusInBottomLeft="@dimen/dp_10"
                    app:shape_radiusInBottomRight="@dimen/dp_10">

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/recyclerView"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:nestedScrollingEnabled="false"
                    android:overScrollMode="never"
                    android:paddingHorizontal="@dimen/dp_8"
                    android:layout_marginTop="@dimen/dp_3"
                    app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                    tool:itemCount="2"
                    tool:listitem="@layout/item_product_privilege" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/dp_1"
                    android:id="@+id/view_line"
                    android:layout_marginTop="@dimen/dp_3"
                    android:layout_marginHorizontal="@dimen/dp_8"
                    app:layout_constraintTop_toBottomOf="@+id/recyclerView"
                    android:background="@color/white_10"/>

                <com.hjq.shape.view.ShapeTextView
                    android:id="@+id/tv_see_all"
                    style="@style/TextAppearance.App.Bold"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="See All"
                    android:padding="@dimen/dp_12"
                    app:shape_radiusInBottomLeft="@dimen/dp_10"
                    app:shape_radiusInBottomRight="@dimen/dp_10"
                    android:textColor="@color/white"
                    android:textSize="@dimen/sp_14"
                    android:gravity="center"
                    app:shape_solidPressedColor="@color/pressedColor"
                    app:layout_constraintTop_toBottomOf="@+id/view_line" />

                </com.hjq.shape.layout.ShapeLinearLayout>

            </com.yang.lovechat.widget.InterceptConstraintLayout>


            <TextView
                android:id="@+id/tv_4"
                android:visibility="gone"
                style="@style/TextAppearance.App.Bold"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/dp_10"
                android:text="People you might like"
                android:textColor="@color/white_80"
                android:textSize="@dimen/sp_16"
                android:layout_marginTop="@dimen/dp_10"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/scl_vip_desc" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/extra_recycler_view"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/dp_10"
                android:layout_marginEnd="@dimen/dp_2"
                android:layout_marginTop="@dimen/dp_10"
                android:nestedScrollingEnabled="false"
                android:overScrollMode="never"
                app:layout_constraintTop_toBottomOf="@+id/tv_4" />


        </androidx.constraintlayout.widget.ConstraintLayout>


    </androidx.core.widget.NestedScrollView>


</androidx.constraintlayout.widget.ConstraintLayout>