<?xml version="1.0" encoding="utf-8"?>
<com.yang.lovechat.widget.SwipeMenuLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tool="http://schemas.android.com/tools"
    android:id="@+id/swipeMenuLayout"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="@dimen/dp_10"
    android:layout_marginBottom="@dimen/dp_5"
    android:clickable="true">


    <LinearLayout
        android:id="@+id/ll_top"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:background="@color/color_FF5ACD"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/dp_25">

        <ImageView
            android:id="@+id/iv_top"
            android:layout_width="@dimen/dp_30"
            android:layout_height="@dimen/dp_30"
            android:src="@drawable/iv_top" />

        <TextView
            android:id="@+id/tv_top"
            style="@style/TextAppearance.App.Normal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_5"
            android:gravity="center"
            android:text="Top"
            android:textColor="@color/white"
            android:textSize="@dimen/sp_14" />
    </LinearLayout>


    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/cl_message"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/ripple_primary"
        android:paddingHorizontal="@dimen/dp_15"
        android:paddingTop="@dimen/dp_10">


        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/iv_avatar"
            android:layout_width="@dimen/dp_55"
            android:layout_height="@dimen/dp_55"
            android:layout_marginBottom="@dimen/dp_10"
            android:padding="@dimen/dp_2"
            android:scaleType="centerCrop"
            android:src="@drawable/iv_avatar"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:shapeAppearanceOverlay="@style/circleStyle"
            app:strokeColor="@color/transparent"
            app:strokeWidth="@dimen/dp_2" />

        <com.hjq.shape.view.ShapeTextView
            android:id="@+id/stv_aline"
            android:layout_width="@dimen/dp_13"
            android:layout_height="@dimen/dp_13"
            android:layout_marginEnd="@dimen/dp_5"
            android:gravity="center"
            android:textSize="@dimen/sp_12"
            android:visibility="gone"
            app:layout_constraintBottom_toBottomOf="@+id/iv_avatar"
            app:layout_constraintEnd_toEndOf="@+id/iv_avatar"
            app:shape_radius="@dimen/dp_30"
            app:shape_strokeColor="@color/white"
            app:shape_strokeSize="@dimen/dp_1"
            app:shape_solidColor="@color/onlineColor" />


        <LinearLayout
            android:id="@+id/ll_container"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/dp_6"
            android:layout_marginTop="@dimen/dp_5"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            app:layout_constraintEnd_toStartOf="@+id/tv_update_time"
            app:layout_constraintStart_toEndOf="@+id/iv_avatar"
            app:layout_constraintTop_toTopOf="@+id/iv_avatar">


            <TextView
                android:id="@+id/tv_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxEms="8"
                style="@style/TextAppearance.App.Bold"
                android:singleLine="true"
                android:textColor="@color/white"
                android:textSize="@dimen/sp_16"
                app:layout_constraintEnd_toStartOf="@+id/tv_update_time"
                app:layout_constraintStart_toEndOf="@+id/iv_avatar"
                app:layout_constraintTop_toTopOf="@+id/iv_avatar" />


        </LinearLayout>


        <TextView
            android:id="@+id/tv_update_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_2"
            android:text="06.12.2026"
            android:textColor="@color/color_999999"
            android:textSize="@dimen/sp_12"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@+id/ll_container" />


        <TextView
            android:id="@+id/tv_message"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/dp_10"
            android:ellipsize="end"
            android:singleLine="true"
            android:textColor="@color/color_999999"
            android:textSize="@dimen/sp_14"
            app:layout_constraintBottom_toBottomOf="@+id/iv_avatar"
            app:layout_constraintEnd_toStartOf="@+id/iv_top_tag"
            app:layout_constraintStart_toStartOf="@+id/ll_container"
            app:layout_constraintTop_toBottomOf="@+id/ll_container" />


        <ImageView
            android:id="@+id/iv_top_tag"
            android:layout_width="@dimen/dp_20"
            android:layout_height="@dimen/dp_20"
            android:layout_marginEnd="@dimen/dp_5"
            android:visibility="gone"
            android:src="@drawable/iv_top_covn_tag"
            app:layout_constraintBottom_toBottomOf="@+id/tv_message"
            app:layout_constraintEnd_toStartOf="@+id/ll_read"
            app:layout_constraintTop_toTopOf="@+id/tv_message" />


        <LinearLayout
            android:id="@+id/ll_read"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            app:layout_constraintBottom_toBottomOf="@+id/tv_message"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@+id/tv_message">

            <com.hjq.shape.view.ShapeTextView
                android:id="@+id/stv_message_count"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/dp_20"
                android:gravity="center"
                android:minWidth="@dimen/dp_20"
                android:paddingHorizontal="@dimen/dp_6"
                android:text="9"
                android:textColor="@color/white"
                android:textSize="@dimen/sp_11"
                android:visibility="gone"
                app:layout_constraintBottom_toBottomOf="@+id/tv_message"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="@+id/tv_message"
                app:shape_radius="@dimen/dp_30"
                app:shape_solidColor="@color/messageCountColor"
                app:shape_strokeColor="@color/white"
                app:shape_strokeSize="@dimen/dp_1_5" />

            <com.hjq.shape.view.ShapeTextView
                android:id="@+id/stv_message_red"
                android:layout_width="@dimen/dp_10"
                android:layout_height="@dimen/dp_10"
                android:gravity="center"
                android:visibility="gone"
                app:layout_constraintBottom_toBottomOf="@+id/tv_message"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="@+id/tv_message"
                app:shape_radius="@dimen/dp_30"
                app:shape_solidColor="@color/messageCountColor" />

        </LinearLayout>


    </androidx.constraintlayout.widget.ConstraintLayout>

    <LinearLayout
        android:id="@+id/ll_delete"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:background="@color/color_FF9800"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/dp_25">

        <ImageView
            android:layout_width="@dimen/dp_30"
            android:layout_height="@dimen/dp_30"
            android:src="@drawable/iv_delete" />

        <TextView
            style="@style/TextAppearance.App.Normal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_5"
            android:gravity="center"
            android:text="Delete"
            android:textColor="@color/white"
            android:textSize="@dimen/sp_14" />
    </LinearLayout>


</com.yang.lovechat.widget.SwipeMenuLayout>



