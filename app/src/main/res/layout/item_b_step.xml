<?xml version="1.0" encoding="utf-8"?>
<com.hjq.shape.layout.ShapeLinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="@dimen/dp_18"
    android:gravity="center"
    app:shape_radius="@dimen/dp_10"
    android:id="@+id/sll_container"
    android:layout_marginBottom="@dimen/dp_15"
    android:orientation="horizontal"
    app:shape_strokeColor="@color/transparent"
    app:shape_strokeSize="@dimen/dp_2"
    app:shape_solidGradientStartColor="@color/color_222222"
    app:shape_solidGradientEndColor="@color/color_222222"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">


    <TextView
        android:id="@+id/tv_title"
        android:layout_width="0dp"
        android:layout_weight="1"
        android:layout_height="wrap_content"
        android:text="I'm a Woman"
        android:textStyle="bold"
        android:textColor="@color/white"
        android:textSize="@dimen/sp_16" />


    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/iv_bg"
        app:shapeAppearance="@style/circleStyle"
        android:layout_width="@dimen/dp_20"
        android:layout_height="@dimen/dp_20"
        />

</com.hjq.shape.layout.ShapeLinearLayout>