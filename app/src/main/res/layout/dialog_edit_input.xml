<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:tool="http://schemas.android.com/tools"
    android:gravity="bottom"
    android:id="@+id/ll_container"
    android:orientation="vertical">

    <com.hjq.shape.layout.ShapeConstraintLayout
        android:id="@+id/scl_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical"
        app:shape_radiusInTopLeft="@dimen/dp_20"
        app:shape_radiusInTopRight="@dimen/dp_20"
        app:shape_solidColor="@color/color_202020">

        <ImageView
            android:id="@+id/iv_close"
            android:layout_width="@dimen/dp_32"
            android:layout_height="@dimen/dp_32"
            android:layout_marginStart="@dimen/dp_25"
            android:layout_marginTop="@dimen/dp_25"
            android:padding="@dimen/dp_2"
            android:src="@drawable/iv_close"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/tv_title"
            style="@style/TextAppearance.App.Bold"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_25"
            tool:text="Nick Name"
            android:textColor="@color/white"
            android:textSize="@dimen/sp_20"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />


        <com.hjq.shape.view.ShapeEditText
            android:id="@+id/set_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/dp_25"
            android:layout_marginTop="@dimen/dp_20"
            android:layout_marginBottom="@dimen/dp_25"
            android:background="@null"
            android:gravity="top"
            android:hint="input…"
            android:maxLength="20"
            android:minLines="1"
            style="@style/TextAppearance.App.Bold"
            android:paddingHorizontal="@dimen/dp_12"
            android:paddingVertical="@dimen/dp_15"
            android:textColor="@color/white"
            android:textColorHint="@color/color_999999"
            android:textSize="@dimen/sp_14"
            app:layout_constraintBottom_toTopOf="@+id/view"
            app:layout_constraintTop_toBottomOf="@+id/tv_title"
            app:shape_radius="@dimen/dp_15"
            app:shape_solidColor="@color/color_2D2D2D" />

        <com.hjq.shape.view.ShapeTextView
            android:id="@+id/tv_save"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/dp_25"
            android:layout_marginTop="@dimen/dp_20"
            android:layout_marginBottom="@dimen/dp_10"
            android:enabled="false"
            android:gravity="center"
            style="@style/TextAppearance.App.Bold"
            android:paddingVertical="@dimen/dp_15"
            android:text="Save"
            android:textColor="@color/white"
            android:textSize="@dimen/sp_16"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/set_text"
            app:shape_radius="@dimen/dp_10"
            app:shape_solidColor="@color/endColor"
            app:shape_solidDisabledColor="@color/color_D9D9D9"
            app:shape_solidPressedColor="@color/pressedColor" />


    </com.hjq.shape.layout.ShapeConstraintLayout>
</LinearLayout>