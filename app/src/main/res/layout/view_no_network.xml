<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:gravity="center"
    android:layout_width="match_parent"
    android:background="@color/color_08070F"
    android:clickable="true"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/iv_image"
        android:layout_width="@dimen/dp_80"
        android:layout_height="@dimen/dp_80"
        android:src="@drawable/iv_no_net"
        android:layout_marginBottom="@dimen/dp_15"
        />

    <TextView
        android:id="@+id/tv_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/dp_25"
        android:text="No Internet"
        android:textColor="@color/white"
        android:textSize="@dimen/sp_18"
        android:layout_marginBottom="@dimen/dp_5"
        android:textStyle="bold"
        android:visibility="gone"
        android:gravity="center"
        />

    <TextView
        android:id="@+id/tv_desc"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Check your Internet and try again."
        android:textColor="@color/white"
        android:textSize="@dimen/sp_14"
        android:layout_marginHorizontal="@dimen/dp_25"
        android:gravity="center"
        />
    <com.hjq.shape.view.ShapeTextView
        android:id="@+id/stv_confirm"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/dp_25"
        android:layout_marginTop="@dimen/dp_30"
        android:gravity="center"
        android:paddingVertical="@dimen/dp_15"
        android:text="Retry"
        android:textColor="@color/white"
        android:textSize="@dimen/sp_16"
        android:textStyle="bold"
        app:shape_solidPressedColor="@color/pressedColor"
        app:shape_radius="@dimen/dp_10"
        app:shape_solidGradientStartColor="@color/startColor"
        app:shape_solidGradientEndColor="@color/endColor"
        />
</LinearLayout>