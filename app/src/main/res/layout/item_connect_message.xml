<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:tool="http://schemas.android.com/tools"
    android:layout_marginTop="@dimen/dp_10"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <com.google.android.material.imageview.ShapeableImageView
        android:layout_width="@dimen/dp_30"
        android:layout_height="@dimen/dp_30"
        android:src="@drawable/iv_avatar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:id="@+id/siv_avatar"
        android:scaleType="centerCrop"
        app:shapeAppearance="@style/circleStyle"/>

    <ImageView
        android:layout_width="@dimen/dp_10"
        android:layout_height="@dimen/dp_10"
        app:layout_constraintEnd_toStartOf="@+id/stv_text"
        app:layout_constraintTop_toTopOf="@+id/stv_text"
        app:layout_constraintBottom_toBottomOf="@+id/stv_text"
        android:layout_marginEnd="-4dp"
        android:src="@drawable/iv_message_left_tag"/>

    <com.hjq.shape.view.ShapeTextView
        android:id="@+id/stv_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constrainedWidth="true"
        tool:text="11111111"
        android:textStyle="bold"
        android:paddingHorizontal="@dimen/dp_8"
        android:paddingVertical="@dimen/dp_5"
        app:shape_radius="@dimen/dp_5"
        android:textSize="@dimen/sp_12"
        android:layout_marginStart="@dimen/dp_8"
        app:shape_solidColor="@color/white"
        android:textColor="@color/textColor"
        app:layout_constraintTop_toTopOf="@+id/siv_avatar"
        app:layout_constraintStart_toEndOf="@+id/siv_avatar"
        />

</androidx.constraintlayout.widget.ConstraintLayout>