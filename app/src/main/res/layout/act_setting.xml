<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <com.yang.lovechat.widget.AppToolBar
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:title="Settings" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:paddingHorizontal="@dimen/dp_10"
        android:orientation="vertical">


        <com.hjq.shape.layout.ShapeLinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clickable="true"
            android:layout_marginTop="@dimen/dp_10"
            android:gravity="center_vertical"
            android:orientation="vertical"
            app:shape_radius="@dimen/dp_10"
            app:shape_solidColor="@color/color_222222">
        <com.hjq.shape.layout.ShapeLinearLayout
            android:id="@+id/sll_account"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clickable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="@dimen/dp_18"
            app:shape_radiusInTopLeft="@dimen/dp_10"
            app:shape_radiusInTopRight="@dimen/dp_10"
            android:padding="@dimen/dp_18"
            app:shape_solidColor="@color/color_222222"
            app:shape_solidPressedColor="@color/pressedColor">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Account"
                android:textColor="@color/white"
                android:textSize="@dimen/sp_16"
                style="@style/TextAppearance.App.Bold" />

            <TextView
                android:id="@+id/tv_email"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/color_999999"
                android:textIsSelectable="true"
                android:textSize="@dimen/sp_14" />

        </com.hjq.shape.layout.ShapeLinearLayout>

        <com.hjq.shape.layout.ShapeLinearLayout
            android:id="@+id/sll_id"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clickable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="@dimen/dp_18"
            app:shape_radiusInBottomLeft="@dimen/dp_10"
            app:shape_radiusInBottomRight="@dimen/dp_10"
            app:shape_solidColor="@color/color_222222"
            app:shape_solidPressedColor="@color/pressedColor">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="ID"
                style="@style/TextAppearance.App.Bold"
                android:textColor="@color/white"
                android:textSize="@dimen/sp_16"
                 />

            <TextView
                android:id="@+id/tv_id"
                android:text="123456"
                android:layout_marginEnd="@dimen/dp_6"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/color_999999"
                android:textSize="@dimen/sp_14" />

            <ImageView
                android:src="@drawable/iv_into"
                android:layout_marginTop="@dimen/dp_1"
                android:layout_width="@dimen/dp_14"
                android:layout_height="@dimen/dp_14"/>

        </com.hjq.shape.layout.ShapeLinearLayout>


        </com.hjq.shape.layout.ShapeLinearLayout>


        <com.hjq.shape.layout.ShapeLinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clickable="true"
            android:layout_marginTop="@dimen/dp_10"
            android:gravity="center_vertical"
            android:orientation="vertical"
            app:shape_radius="@dimen/dp_10"

            app:shape_solidColor="@color/color_222222">
        <com.hjq.shape.layout.ShapeLinearLayout
            android:id="@+id/sll_version"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clickable="true"
            app:shape_radiusInTopLeft="@dimen/dp_10"
            app:shape_radiusInTopRight="@dimen/dp_10"
            android:padding="@dimen/dp_18"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            app:shape_solidColor="@color/color_222222"
            app:shape_solidPressedColor="@color/pressedColor">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="App Version"
                style="@style/TextAppearance.App.Bold"
                android:textColor="@color/white"
                android:textSize="@dimen/sp_16"
                />

            <TextView
                android:id="@+id/tv_version"
                android:text="V 1.0.0"
                android:layout_marginEnd="@dimen/dp_6"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/color_999999"
                android:textIsSelectable="true"
                android:textSize="@dimen/sp_14" />

        </com.hjq.shape.layout.ShapeLinearLayout>

            <com.hjq.shape.layout.ShapeLinearLayout
                android:id="@+id/sll_feedback"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="@dimen/dp_18"
                app:shape_solidColor="@color/color_222222"
                app:shape_solidPressedColor="@color/pressedColor">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="FeedBack"
                    android:textColor="@color/white"
                    android:textSize="@dimen/sp_16"
                    style="@style/TextAppearance.App.Bold" />

                <ImageView
                    android:layout_width="@dimen/dp_14"
                    android:layout_height="@dimen/dp_14"
                    android:src="@drawable/iv_into" />

            </com.hjq.shape.layout.ShapeLinearLayout>

        <com.hjq.shape.layout.ShapeLinearLayout
            android:id="@+id/sll_agreement"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="@dimen/dp_18"
            app:shape_solidColor="@color/color_222222"
            app:shape_solidPressedColor="@color/pressedColor">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="User Agreement"
                android:textColor="@color/white"
                android:textSize="@dimen/sp_16"
                style="@style/TextAppearance.App.Bold" />

            <ImageView
                android:layout_width="@dimen/dp_14"
                android:layout_height="@dimen/dp_14"
                android:src="@drawable/iv_into" />

        </com.hjq.shape.layout.ShapeLinearLayout>



        <com.hjq.shape.layout.ShapeLinearLayout
            android:id="@+id/sll_privacy"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            app:shape_radiusInBottomLeft="@dimen/dp_10"
            app:shape_radiusInBottomRight="@dimen/dp_10"
            android:padding="@dimen/dp_18"
            app:shape_solidColor="@color/color_222222"
            app:shape_solidPressedColor="@color/pressedColor">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Privacy Policy"
                android:textColor="@color/white"
                android:textSize="@dimen/sp_16"
                style="@style/TextAppearance.App.Bold" />

            <ImageView
                android:layout_width="@dimen/dp_14"
                android:layout_height="@dimen/dp_14"
                android:src="@drawable/iv_into" />

        </com.hjq.shape.layout.ShapeLinearLayout>
        
        </com.hjq.shape.layout.ShapeLinearLayout>



        <com.hjq.shape.layout.ShapeLinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clickable="true"
            android:layout_marginTop="@dimen/dp_10"
            android:gravity="center_vertical"
            android:orientation="vertical"
            app:shape_radius="@dimen/dp_10"

            app:shape_solidColor="@color/color_222222">
        <com.hjq.shape.layout.ShapeLinearLayout
            android:id="@+id/sll_delete"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            app:shape_radiusInTopLeft="@dimen/dp_10"
            app:shape_radiusInTopRight="@dimen/dp_10"
            android:padding="@dimen/dp_18"
            app:shape_solidColor="@color/color_222222"
            app:shape_solidPressedColor="@color/pressedColor">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Delete Account"
                android:textColor="@color/white"
                android:textSize="@dimen/sp_16"
                style="@style/TextAppearance.App.Bold" />

            <ImageView
                android:layout_width="@dimen/dp_14"
                android:layout_height="@dimen/dp_14"
                android:src="@drawable/iv_into" />


        </com.hjq.shape.layout.ShapeLinearLayout>




        <com.hjq.shape.layout.ShapeLinearLayout
            android:id="@+id/sll_login_out"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            app:shape_radiusInBottomLeft="@dimen/dp_10"
            app:shape_radiusInBottomRight="@dimen/dp_10"
            android:padding="@dimen/dp_18"
            app:shape_solidColor="@color/color_222222"
            app:shape_solidPressedColor="@color/pressedColor">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Logout"
                android:textColor="@color/white"
                android:textSize="@dimen/sp_16"
                style="@style/TextAppearance.App.Bold" />

            <ImageView
                android:layout_width="@dimen/dp_14"
                android:layout_height="@dimen/dp_14"
                android:src="@drawable/iv_into" />

        </com.hjq.shape.layout.ShapeLinearLayout>
        
        </com.hjq.shape.layout.ShapeLinearLayout>



    </LinearLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="service@dawnmeet-chat.com"
        android:textColor="@color/endColor"
        android:id="@+id/tv_bottom_email"
        android:gravity="center"
        android:layout_gravity="center"
        android:layout_marginBottom="@dimen/dp_10"
        android:textSize="@dimen/sp_12" />

</LinearLayout>