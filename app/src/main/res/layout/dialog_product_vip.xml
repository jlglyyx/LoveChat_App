<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black"
    android:gravity="center"
    android:orientation="vertical">


    <TextView
        android:id="@+id/tv_1"
        style="@style/TextAppearance.App.Bold"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="Premium"
        android:textColor="@color/white"
        android:textSize="@dimen/sp_20"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <ImageView
        android:id="@+id/iv_close"
        android:layout_width="@dimen/dp_40"
        android:layout_height="@dimen/dp_40"
        android:layout_gravity="start"
        android:padding="@dimen/dp_5"
        android:src="@drawable/iv_close"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />


    <TextView
        android:id="@+id/tv_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="start"
        android:layout_marginHorizontal="@dimen/dp_15"
        android:layout_marginBottom="@dimen/dp_15"
        android:text="Get premium to unlock previlege of Private Album"
        android:textColor="@color/black"
        android:textSize="@dimen/sp_16"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@+id/tv_1" />


    <com.hjq.shape.layout.ShapeRecyclerView
        android:id="@+id/privilege_recycler_view"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginHorizontal="@dimen/dp_15"
        app:layout_constraintBottom_toTopOf="@+id/recyclerView"
        android:clipToPadding="false"
        android:nestedScrollingEnabled="false"
        android:padding="@dimen/dp_10"
        app:shape_solidColor="@color/color_222222"
        app:shape_radius="@dimen/dp_10"
        android:overScrollMode="never"
        android:layout_marginVertical="@dimen/dp_10"
        app:layout_constraintTop_toBottomOf="@+id/tv_title"
        tools:itemCount="5"
        tools:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
        tools:listitem="@layout/item_product_privilege" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:clipToPadding="false"
        android:overScrollMode="never"
        android:paddingHorizontal="@dimen/dp_10"
        android:layout_marginBottom="@dimen/dp_10"
        app:layout_constraintBottom_toTopOf="@+id/tv_desc"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        tools:itemCount="4"
        tools:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
        tools:listitem="@layout/item_product_vip"
        tools:orientation="horizontal" />


    <TextView
        android:id="@+id/tv_desc"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/dp_15"
        android:layout_marginBottom="@dimen/dp_4"
        android:gravity="center"
        android:textColor="@color/color_999999"
        android:textSize="@dimen/sp_10"
        app:layout_constraintBottom_toTopOf="@+id/tv_privacy" />

    <TextView
        android:id="@+id/tv_privacy"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/dp_15"
        android:layout_marginBottom="@dimen/dp_10"
        android:gravity="center"
        android:textColor="@color/color_999999"
        android:textSize="@dimen/sp_10"
        app:layout_constraintBottom_toTopOf="@+id/tv_time" />


    <TextView
        android:id="@+id/tv_time"
        style="@style/TextAppearance.App.Bold"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/dp_15"
        android:layout_marginBottom="@dimen/dp_7"
        android:gravity="center"
        android:textColor="@color/color_999999"
        android:textSize="@dimen/sp_12"
        android:visibility="gone"
        app:layout_constraintBottom_toTopOf="@+id/stv_next"
        tools:text="Expiration date: 2021-09-23" />

    <com.hjq.shape.view.ShapeTextView
        android:id="@+id/stv_next"
        style="@style/TextAppearance.App.Bold"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/dp_15"
        android:layout_marginTop="@dimen/dp_12"
        android:layout_marginBottom="@dimen/dp_15"
        android:gravity="center"
        android:paddingVertical="@dimen/dp_15"
        android:text="Get Premium"
        android:textColor="@color/white"
        android:textSize="@dimen/sp_16"
        app:layout_constraintBottom_toBottomOf="parent"
        app:shape_radius="@dimen/dp_30"
        app:shape_solidColor="@color/black"
        app:shape_solidGradientStartColor="@color/startColor"
        app:shape_solidGradientEndColor="@color/endColor"
        app:shape_solidPressedColor="@color/pressedColor" />


</androidx.constraintlayout.widget.ConstraintLayout>
