<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">


    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/ll_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_18"
        android:orientation="horizontal"
        android:paddingHorizontal="@dimen/dp_8"
        app:layout_constraintTop_toTopOf="parent">


        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="horizontal"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <com.hjq.shape.view.ShapeView
                android:layout_width="@dimen/dp_30"
                android:layout_height="@dimen/dp_4"
                app:shape_radius="@dimen/dp_5"
                app:shape_solidColor="@color/color_FF5ACD" />

            <com.hjq.shape.view.ShapeView
                android:layout_width="@dimen/dp_30"
                android:layout_height="@dimen/dp_4"
                android:layout_marginHorizontal="@dimen/dp_4"
                app:shape_radius="@dimen/dp_5"
                app:shape_solidColor="@color/white_50" />

            <com.hjq.shape.view.ShapeView
                android:layout_width="@dimen/dp_30"
                android:layout_height="@dimen/dp_4"
                app:shape_radius="@dimen/dp_5"
                app:shape_solidColor="@color/white_50" />


        </LinearLayout>


    </androidx.constraintlayout.widget.ConstraintLayout>


    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/dp_25"
        app:layout_constraintTop_toTopOf="parent">


        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_30"
            android:text="What's your sex?"
            android:textColor="@color/white"
            android:textSize="@dimen/sp_20"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_8"
            android:text="Help us match better people for you. Once selected, this cannot be modified."
            android:textColor="@color/color_999999"
            android:textSize="@dimen/sp_14"
            android:textStyle="bold" />

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_15"
            android:gravity="center"
            android:orientation="horizontal">

            <com.hjq.shape.layout.ShapeLinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:id="@+id/sll_man"
                android:padding="@dimen/dp_15"
                app:layout_constraintDimensionRatio="1:1"
                app:layout_constraintEnd_toStartOf="@+id/sll_women"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                android:orientation="vertical"
                app:shape_radius="@dimen/dp_50"
                app:shape_solidGradientStartColor="@color/startColor"
                app:shape_solidGradientEndColor="@color/endColor"
                app:shape_solidColor="@color/color_222222">

                <ImageView
                    android:layout_width="@dimen/dp_30"
                    android:layout_height="@dimen/dp_30"
                    android:src="@drawable/iv_male" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp_10"
                    android:text="man"
                    android:textColor="@color/white"
                    android:textSize="@dimen/sp_14"
                    android:textStyle="bold" />
            </com.hjq.shape.layout.ShapeLinearLayout>

            <com.hjq.shape.layout.ShapeLinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:padding="@dimen/dp_15"
                android:id="@+id/sll_women"
                app:layout_constraintDimensionRatio="1:1"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toEndOf="@+id/sll_man"
                app:layout_constraintEnd_toStartOf="@+id/sll_other"
                android:layout_marginHorizontal="@dimen/dp_20"
                android:orientation="vertical"
                app:shape_radius="@dimen/dp_50"
                app:shape_solidColor="@color/color_222222">

                <ImageView
                    android:layout_width="@dimen/dp_30"
                    android:layout_height="@dimen/dp_30"
                    android:src="@drawable/iv_female" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp_10"
                    android:text="woman"
                    android:textColor="@color/white"
                    android:textSize="@dimen/sp_14"
                    android:textStyle="bold" />
            </com.hjq.shape.layout.ShapeLinearLayout>

            <com.hjq.shape.layout.ShapeLinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:id="@+id/sll_other"
                android:orientation="vertical"
                android:padding="@dimen/dp_15"
                app:shape_radius="@dimen/dp_50"
                app:layout_constraintDimensionRatio="1:1"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@+id/sll_women"
                app:shape_solidColor="@color/color_222222">

                <ImageView
                    android:layout_width="@dimen/dp_30"
                    android:layout_height="@dimen/dp_30"
                    android:src="@drawable/iv_other" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp_10"
                    android:text="other"
                    android:textColor="@color/white"
                    android:textSize="@dimen/sp_14"
                    android:textStyle="bold" />
            </com.hjq.shape.layout.ShapeLinearLayout>


        </androidx.constraintlayout.widget.ConstraintLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_20"
            android:text="What should we call you?"
            android:textColor="@color/white"
            android:textSize="@dimen/sp_20"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_8"
            android:text="This is how others will see you"
            android:textColor="@color/color_999999"
            android:textSize="@dimen/sp_14"
            android:textStyle="bold" />

        <com.hjq.shape.view.ShapeEditText
            android:id="@+id/set_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_15"
            android:maxLength="20"
            android:padding="@dimen/dp_19"
            android:singleLine="true"
            android:textColor="@color/white"
            android:hint="Enter your name"
            android:textColorHint="@color/color_999999"
            android:textSize="@dimen/sp_16"
            app:shape_radius="@dimen/dp_10"
            app:shape_solidColor="@color/color_222222"
            app:shape_strokeSize="@dimen/dp_1" />


        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_20"
            android:text="When's your birthday?"
            android:textColor="@color/white"
            android:textSize="@dimen/sp_20"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_8"
            android:text="Only users aged 18 or older are allowed"
            android:textColor="@color/color_999999"
            android:textSize="@dimen/sp_14"
            android:textStyle="bold" />

        <com.yang.lovechat.widget.TimePickView
            android:id="@+id/mTimePickView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />


    </LinearLayout>


    <com.hjq.shape.view.ShapeTextView
        android:id="@+id/stv_next"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/dp_25"
        android:layout_marginVertical="@dimen/dp_15"
        android:enabled="false"
        android:gravity="center"
        android:paddingVertical="@dimen/dp_15"
        android:text="Continue"
        android:textColor="@color/white"
        android:textSize="@dimen/sp_16"
        style="@style/TextAppearance.App.Bold"
        app:shape_radius="@dimen/dp_30"
        app:shape_solidDisabledColor="@color/color_D9D9D9"
        app:shape_solidGradientEndColor="@color/startColor"
        app:shape_solidGradientStartColor="@color/endColor"
        app:shape_solidPressedColor="@color/pressedColor" />
</LinearLayout>