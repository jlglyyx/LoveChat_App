<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/color_08070F">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <com.youth.banner.Banner
            android:id="@+id/banner"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            app:layout_constraintDimensionRatio="1:1.5"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <com.hjq.shape.view.ShapeView
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_gravity="bottom"
            app:layout_constraintBottom_toBottomOf="@+id/banner"
            app:layout_constraintEnd_toEndOf="@+id/banner"
            app:layout_constraintHeight_percent="0.3"
            app:layout_constraintStart_toStartOf="@+id/banner"
            app:shape_radiusInBottomLeft="@dimen/dp_20"
            app:shape_radiusInBottomRight="@dimen/dp_20"
            app:shape_solidGradientCenterColor="@color/black_50"
            app:shape_solidGradientEndColor="@color/black"
            app:shape_solidGradientOrientation="topToBottom"
            app:shape_solidGradientStartColor="@color/transparent" />


        <LinearLayout
            android:id="@+id/ll_indicator"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/dp_30"
            android:layout_marginBottom="@dimen/dp_10"
            android:gravity="center"
            app:layout_constraintBottom_toTopOf="@+id/message_recycler_view"
            app:layout_constraintEnd_toEndOf="@+id/banner"
            app:layout_constraintStart_toStartOf="@+id/banner">

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fillViewport="true"
                android:overScrollMode="never"
                android:scrollbars="none"
                tools:ignore="UselessParent">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <com.youth.banner.indicator.RectangleIndicator
                        android:id="@+id/mIndicator"
                        android:layout_width="wrap_content"
                        android:layout_height="@dimen/dp_30" />
                </LinearLayout>

            </HorizontalScrollView>

        </LinearLayout>


        <LinearLayout
            android:id="@+id/ll_close"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_5"
            android:layout_marginEnd="@dimen/dp_10"
            android:orientation="vertical"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <ImageView
                android:id="@+id/iv_close"
                android:layout_width="@dimen/dp_40"
                android:layout_height="@dimen/dp_40"
                android:padding="@dimen/dp_5"
                android:src="@drawable/iv_close" />
        </LinearLayout>


        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/message_recycler_view"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/dp_25"
            android:layout_marginBottom="@dimen/dp_10"
            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
            app:layout_constraintBottom_toTopOf="@+id/stv_send"
            tools:itemCount="3"
            tools:listitem="@layout/item_connect_message" />


        <com.hjq.shape.view.ShapeTextView
            android:id="@+id/stv_send"
            style="@style/TextAppearance.App.Bold"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/dp_25"
            android:layout_marginBottom="@dimen/dp_25"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingVertical="@dimen/dp_15"
            android:text="Send Connect Now"
            android:textColor="@color/white"
            android:textSize="@dimen/sp_16"
            app:layout_constraintBottom_toBottomOf="parent"
            app:shape_radius="@dimen/dp_10"
            app:shape_solidGradientEndColor="@color/endColor"
            app:shape_solidGradientStartColor="@color/startColor"
            app:shape_solidPressedColor="@color/pressedColor">

        </com.hjq.shape.view.ShapeTextView>



        <com.hjq.shape.layout.ShapeLinearLayout
            android:id="@+id/sll_count"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingVertical="@dimen/dp_2"
            android:paddingHorizontal="@dimen/dp_5"
            app:layout_constraintBottom_toTopOf="@+id/stv_send"
            app:layout_constraintEnd_toEndOf="@+id/stv_send"
            app:shape_radius="@dimen/dp_15"
            android:layout_marginBottom="-15dp"
            app:shape_solidGradientStartColor="@color/white"
            app:shape_solidGradientEndColor="@color/white">

            <ImageView
                android:layout_width="@dimen/dp_15"
                android:layout_height="@dimen/dp_15"
                android:src="@drawable/iv_diamond" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:drawablePadding="@dimen/dp_6"
                android:gravity="center"
                android:id="@+id/tv_price"
                style="@style/TextAppearance.App.Bold"
                android:text="80"
                android:layout_marginEnd="@dimen/dp_5"
                android:textColor="@color/textColor"
                android:textSize="@dimen/sp_12"
                />
        </com.hjq.shape.layout.ShapeLinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>


</androidx.constraintlayout.widget.ConstraintLayout>