<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">


    <com.yang.lovechat.widget.AppToolBar
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:title="Report" />

    <androidx.core.widget.NestedScrollView
        android:id="@+id/scrollView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/dp_15"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_marginTop="@dimen/dp_15"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:textStyle="bold"
                        android:text="Description"
                        android:textColor="@color/white"
                        android:textSize="@dimen/sp_16"
                        />


                </LinearLayout>

                <com.hjq.shape.view.ShapeEditText
                    android:id="@+id/set_text"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp_14"
                    android:background="@null"
                    android:gravity="top"
                    android:hint="If you want to report a particular user , simply go to private chat then report."
                    android:maxLength="500"
                    android:minLines="7"
                    android:textStyle="bold"
                    android:paddingHorizontal="@dimen/dp_12"
                    android:paddingVertical="@dimen/dp_15"
                    android:textColor="@color/white"
                    android:textColorHint="@color/color_999999"
                    android:textSize="@dimen/sp_14"
                    app:shape_radius="@dimen/dp_12"
                    app:shape_solidColor="@color/color_222222"
                    />
                <TextView
                    android:id="@+id/tv_count"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0/500"
                    android:layout_marginEnd="@dimen/dp_10"
                    android:layout_marginTop="-25dp"
                    android:layout_gravity="end"
                    android:textColor="@color/white"
                    android:textSize="@dimen/sp_12" />

            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/dp_15"
                android:layout_marginTop="@dimen/dp_20"
                android:text="Contact Email（optional）"
                android:textColor="@color/white"
                android:textStyle="bold"
                android:textSize="@dimen/sp_16"
                />

            <TextView
                android:layout_marginHorizontal="@dimen/dp_15"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_8"
                android:text="We'll reply it within 1 business day"
                android:textColor="@color/white"
                android:textSize="@dimen/sp_14" />

            <com.hjq.shape.view.ShapeEditText
                android:id="@+id/set_emails"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/dp_15"
                android:layout_marginTop="@dimen/dp_14"
                android:gravity="top"
                android:minLines="1"
                android:maxLength="50"
                android:hint="Please enter your Email"
                android:textStyle="bold"
                android:paddingHorizontal="@dimen/dp_12"
                android:paddingVertical="@dimen/dp_15"
                android:textColor="@color/white"
                android:textColorHint="@color/color_999999"
                android:textSize="@dimen/sp_15"
                app:shape_solidColor="@color/color_222222"
                app:shape_radius="@dimen/dp_12"/>

            <View
                android:layout_width="match_parent"
                android:layout_height="@dimen/dp_0"
                android:layout_weight="1" />

            <com.hjq.shape.view.ShapeTextView
                android:id="@+id/stv_next"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/dp_20"
                android:gravity="center"
                android:paddingVertical="@dimen/dp_15"
                android:text="Submit"
                android:enabled="false"
                android:layout_marginBottom="@dimen/dp_15"
                android:textColor="@color/white"
                android:textSize="@dimen/sp_16"
                app:shape_radius="@dimen/dp_30"
                android:textStyle="bold"
                app:shape_solidGradientStartColor="@color/startColor"
                app:shape_solidGradientEndColor="@color/endColor"
                app:shape_textDisabledColor="@color/white"
                app:shape_solidDisabledColor="@color/color_D9D9D9"
                app:shape_solidPressedColor="@color/pressedColor"/>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
