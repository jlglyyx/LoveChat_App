<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">


    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:id="@+id/ll_container"
        android:layout_marginTop="@dimen/dp_18"
        app:layout_constraintTop_toTopOf="parent"
        android:paddingHorizontal="@dimen/dp_8"
        android:orientation="horizontal">




        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:gravity="center"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            android:orientation="horizontal">

            <com.hjq.shape.view.ShapeView
                app:shape_solidColor="@color/color_FF5ACD"
                android:layout_width="@dimen/dp_30"
                app:shape_radius="@dimen/dp_5"
                android:layout_height="@dimen/dp_4"/>
            <com.hjq.shape.view.ShapeView
                app:shape_solidColor="@color/color_FF5ACD"
                android:layout_width="@dimen/dp_30"
                app:shape_radius="@dimen/dp_5"
                android:layout_marginHorizontal="@dimen/dp_4"
                android:layout_height="@dimen/dp_4"/>
            <com.hjq.shape.view.ShapeView
                app:shape_solidColor="@color/white_50"
                android:layout_width="@dimen/dp_30"
                app:shape_radius="@dimen/dp_5"
                android:layout_height="@dimen/dp_4"/>


        </LinearLayout>




    </androidx.constraintlayout.widget.ConstraintLayout>



    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:overScrollMode="never">


        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            app:layout_constraintTop_toTopOf="parent">


            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_30"
                android:text="What are you looking for?"
                android:layout_marginHorizontal="@dimen/dp_25"
                android:textColor="@color/white"
                android:textSize="@dimen/sp_20"
                android:textStyle="bold"
                 />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_8"
                android:layout_marginHorizontal="@dimen/dp_25"
                android:text="Select what you're looking for"
                android:textColor="@color/color_999999"
                android:textSize="@dimen/sp_14"
                android:textStyle="bold" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recyclerView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_10"
                tools:itemCount="1"
                android:layout_marginHorizontal="@dimen/dp_25"
                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                android:nestedScrollingEnabled="false"
                android:overScrollMode="never"
                tools:listitem="@layout/item_b_step" />



            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_20"
                android:text="Select your interests"
                android:layout_marginHorizontal="@dimen/dp_25"
                android:textColor="@color/white"
                android:textSize="@dimen/sp_20"
                android:textStyle="bold"
                />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_8"
                android:layout_marginHorizontal="@dimen/dp_25"
                android:text="Choose some that match you"
                android:textColor="@color/color_999999"
                android:textSize="@dimen/sp_14"
                android:textStyle="bold" />


            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/interest_recycler_view"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/dp_21"
                android:layout_marginTop="@dimen/dp_10"
                android:layout_marginEnd="@dimen/dp_16"
                android:nestedScrollingEnabled="false"
                android:overScrollMode="never"
                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                tools:listitem="@layout/item_interset" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <com.hjq.shape.view.ShapeTextView
        android:id="@+id/stv_next"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/dp_25"
        android:layout_marginVertical="@dimen/dp_15"
        android:enabled="false"
        android:gravity="center"
        android:paddingVertical="@dimen/dp_15"
        android:text="Continue"
        android:textColor="@color/white"
        android:textSize="@dimen/sp_16"
        android:textStyle="bold"
        app:shape_radius="@dimen/dp_30"
        app:shape_solidGradientStartColor="@color/startColor"
        app:shape_solidGradientEndColor="@color/endColor"
        app:shape_solidDisabledColor="@color/color_D9D9D9"
        app:shape_solidPressedColor="@color/pressedColor" />
</LinearLayout>