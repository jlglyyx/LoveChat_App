<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tool="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/ll_root_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">


        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/appToolBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            app:layout_constraintTop_toTopOf="parent">

            <ImageView
                android:id="@+id/iv_back"
                android:layout_width="@dimen/dp_35"
                android:layout_height="@dimen/dp_35"

                android:layout_marginStart="@dimen/dp_6"
                android:padding="@dimen/dp_8"
                android:src="@drawable/iv_back"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/siv_avatar"
                android:layout_width="@dimen/dp_40"
                android:layout_height="@dimen/dp_40"
                android:layout_marginVertical="@dimen/dp_8"
                android:layout_marginStart="@dimen/dp_5"
                android:scaleType="centerCrop"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toEndOf="@+id/iv_back"
                app:layout_constraintTop_toTopOf="parent"
                app:shapeAppearanceOverlay="@style/circleStyle" />

            <com.hjq.shape.view.ShapeTextView
                android:id="@+id/stv_aline"
                android:layout_width="@dimen/dp_9"
                android:layout_height="@dimen/dp_9"
                android:gravity="center"
                app:layout_constraintBottom_toBottomOf="@+id/siv_avatar"
                app:layout_constraintEnd_toEndOf="@+id/siv_avatar"
                app:shape_radius="@dimen/dp_30"
                app:shape_solidColor="@color/onlineColor" />

            <TextView
                android:id="@+id/tv_name"
                style="@style/TextAppearance.App.Bold"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/dp_10"
                android:ellipsize="middle"
                android:maxEms="7"
                android:singleLine="true"
                android:textColor="@color/white"
                android:textSize="@dimen/sp_18"
                app:layout_constrainedWidth="true"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toEndOf="@+id/siv_avatar"
                app:layout_constraintTop_toTopOf="parent"
                tool:text="Name" />

            <ImageView
                android:id="@+id/iv_vip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/dp_6"
                android:src="@drawable/iv_crown"
                android:visibility="gone"
                app:layout_constraintBottom_toBottomOf="@+id/tv_name"
                app:layout_constraintStart_toEndOf="@+id/tv_name"
                app:layout_constraintTop_toTopOf="@+id/tv_name" />

            <ImageView
                android:id="@+id/iv_more"
                android:layout_width="@dimen/dp_35"
                android:layout_height="@dimen/dp_35"
                android:layout_marginEnd="@dimen/dp_6"
                android:padding="@dimen/dp_6"
                android:src="@drawable/iv_more"
                android:visibility="visible"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

        </androidx.constraintlayout.widget.ConstraintLayout>


        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/chat_recyclerView"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:overScrollMode="never"
            android:paddingTop="@dimen/dp_5"
            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
            app:layout_constraintBottom_toTopOf="@+id/sll_container"
            app:layout_constraintTop_toBottomOf="@+id/appToolBar" />


        <LinearLayout
            android:id="@+id/sll_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            app:layout_constraintBottom_toBottomOf="parent">

            <HorizontalScrollView
                android:id="@+id/scrollView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/dp_10"
                android:fillViewport="true"
                android:paddingHorizontal="@dimen/dp_15"
                android:scrollbars="none"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">


                    <com.hjq.shape.view.ShapeTextView
                        android:id="@+id/stv_1"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:paddingHorizontal="@dimen/dp_12"
                        android:paddingVertical="@dimen/dp_8"
                        android:text="Hey there 👋"
                        android:textColor="@color/textColor"
                        android:textSize="@dimen/sp_14"
                        app:shape_radius="@dimen/dp_18"
                        app:shape_solidColor="@color/textColor" />

                    <com.hjq.shape.view.ShapeTextView
                        android:id="@+id/stv_2"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginHorizontal="@dimen/dp_15"
                        android:paddingHorizontal="@dimen/dp_12"
                        android:paddingVertical="@dimen/dp_8"
                        android:text="Wow,nice pic!😻 "
                        android:textColor="@color/textColor"
                        android:textSize="@dimen/sp_14"
                        app:shape_radius="@dimen/dp_18"
                        app:shape_solidColor="@color/textColor" />

                    <com.hjq.shape.view.ShapeTextView
                        android:id="@+id/stv_3"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:paddingHorizontal="@dimen/dp_12"
                        android:paddingVertical="@dimen/dp_8"
                        android:text="Hey baby💦 you look so hot"
                        android:textColor="@color/textColor"
                        android:textSize="@dimen/sp_14"
                        app:shape_radius="@dimen/dp_18"
                        app:shape_solidColor="@color/textColor" />

                </LinearLayout>

            </HorizontalScrollView>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginVertical="@dimen/dp_8"
                android:gravity="bottom"
                android:orientation="horizontal"
                android:paddingHorizontal="@dimen/dp_8">




                <com.hjq.shape.layout.ShapeLinearLayout
                    android:id="@+id/sl_chat"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:paddingHorizontal="@dimen/dp_8"
                    app:shape_radius="@dimen/dp_10"
                    app:shape_solidColor="@color/color_222222">

                    <ImageView
                        android:id="@+id/iv_send_media"
                        android:layout_width="@dimen/dp_35"
                        android:layout_height="@dimen/dp_35"
                        android:padding="@dimen/dp_4"
                        android:layout_gravity="bottom"
                        android:layout_marginBottom="@dimen/dp_7"
                        android:src="@drawable/iv_send_media" />

                    <ImageView
                        android:id="@+id/iv_send_p_media"
                        android:layout_width="@dimen/dp_35"
                        android:layout_height="@dimen/dp_35"
                        android:padding="@dimen/dp_4"
                        android:layout_gravity="bottom"
                        android:layout_marginBottom="@dimen/dp_7"
                        android:src="@drawable/iv_send_p_media" />

                    <EditText
                        android:id="@+id/set_send_message"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:background="@null"
                        android:hint="Send..."
                        android:maxLength="1000"
                        android:maxLines="3"
                        android:paddingHorizontal="@dimen/dp_5"
                        android:paddingVertical="@dimen/dp_13"
                        android:textColor="@color/white"
                        android:textColorHint="@color/color_999999"
                        android:textSize="@dimen/sp_16" />


                    <ImageView
                        android:id="@+id/iv_input"
                        android:layout_width="@dimen/dp_35"
                        android:layout_height="@dimen/dp_35"
                        android:layout_gravity="bottom"
                        android:layout_marginBottom="@dimen/dp_7"
                        android:padding="@dimen/dp_2"
                        android:src="@drawable/iv_input"
                        android:visibility="gone" />

                    <ImageView
                        android:id="@+id/iv_emoji"
                        android:layout_width="@dimen/dp_35"
                        android:layout_height="@dimen/dp_35"
                        android:layout_gravity="bottom"
                        android:layout_marginBottom="@dimen/dp_7"
                        android:padding="@dimen/dp_4"
                        android:src="@drawable/iv_send_emoji" />

                </com.hjq.shape.layout.ShapeLinearLayout>


                <ImageView
                    android:id="@+id/iv_send_message"
                    android:layout_width="@dimen/dp_55"
                    android:layout_height="@dimen/dp_48"
                    android:src="@drawable/iv_send"
                    android:layout_marginStart="@dimen/dp_5"
                    android:visibility="visible" />

            </LinearLayout>

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/dp_15">

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/emoji_recyclerView"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/dp_250"
                    android:overScrollMode="never"
                    android:visibility="gone"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="parent" />

            </FrameLayout>

        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
