<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tool="http://schemas.android.com/tools"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <com.yang.lovechat.widget.ErrorReLoadView
        android:id="@+id/errorReLoadView"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <com.yang.lovechat.widget.AppToolBar
                android:id="@+id/appToolBar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:layout_constraintTop_toTopOf="parent"
                app:title="Edit Info" />


            <androidx.core.widget.NestedScrollView
                android:layout_width="match_parent"
                android:layout_height="0dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/appToolBar">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingBottom="@dimen/dp_20">

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/picture_recycler_view"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginHorizontal="@dimen/dp_7"
                        android:layout_marginTop="@dimen/dp_10"
                        android:nestedScrollingEnabled="false"
                        android:overScrollMode="never"
                        tools:itemCount="1"
                        tools:layoutManager="androidx.recyclerview.widget.GridLayoutManager"
                        tools:listitem="@layout/item_add_photo"
                        tools:spanCount="3" />


                    <com.hjq.shape.layout.ShapeLinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">


                        <com.hjq.shape.layout.ShapeLinearLayout
                            android:id="@+id/scl_intent"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:paddingHorizontal="@dimen/dp_10"
                            app:shape_radius="@dimen/dp_10"
                            android:orientation="vertical"
                            android:layout_marginTop="@dimen/dp_10"
                            android:layout_marginHorizontal="@dimen/dp_10"
                            app:shape_solidColor="@color/color_222222"
                            android:paddingTop="@dimen/dp_10">

                            <TextView
                                style="@style/TextAppearance.App.Bold"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Style"
                                android:textColor="@color/white"
                                android:textSize="@dimen/sp_18" />


                            <com.hjq.shape.view.ShapeTextView
                                android:id="@+id/stv_intent"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:drawableEnd="@drawable/iv_into"
                                android:gravity="center_vertical"
                                android:paddingVertical="@dimen/dp_15"
                                android:textColor="@color/white"
                                android:textSize="@dimen/sp_14"
                                android:textStyle="bold"
                                android:hint="Hoping to find?"
                                android:textColorHint="@color/color_999999"/>


                            <com.hjq.shape.view.ShapeTextView
                                android:id="@+id/stv_bio"
                                style="@style/TextAppearance.App.Bold"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:drawableEnd="@drawable/iv_into"
                                android:paddingVertical="@dimen/dp_15"
                                android:textColor="@color/white"
                                android:textSize="@dimen/sp_14"
                                android:hint="Write down what you’re looking for"
                                android:textColorHint="@color/color_999999"
                                />

                        </com.hjq.shape.layout.ShapeLinearLayout>

                        <com.hjq.shape.layout.ShapeLinearLayout
                            android:id="@+id/scl_basic"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:paddingHorizontal="@dimen/dp_10"
                            app:shape_radius="@dimen/dp_10"
                            android:orientation="vertical"
                            android:layout_marginTop="@dimen/dp_10"
                            android:layout_marginHorizontal="@dimen/dp_10"
                            app:shape_solidColor="@color/color_222222"
                            android:paddingTop="@dimen/dp_10">

                            <TextView
                                android:id="@+id/tv_basic"
                                style="@style/TextAppearance.App.Bold"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Info"
                                android:textColor="@color/white"
                                android:textSize="@dimen/sp_18" />

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:id="@+id/ll_name"
                                android:orientation="horizontal">

                                <com.hjq.shape.view.ShapeTextView
                                    style="@style/TextAppearance.App.Bold"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:drawablePadding="@dimen/dp_3"
                                    android:textColor="@color/white"
                                    android:textSize="@dimen/sp_14"
                                    android:text="Name" />

                                <com.hjq.shape.view.ShapeTextView
                                    android:id="@+id/stv_name"
                                    style="@style/TextAppearance.App.Bold"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:drawableEnd="@drawable/iv_into"
                                    android:drawablePadding="@dimen/dp_3"
                                    android:paddingVertical="@dimen/dp_15"
                                    android:textColor="@color/white_80"
                                    android:textSize="@dimen/sp_14"
                                    tool:text="xxxx" />

                            </LinearLayout>
                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:id="@+id/ll_avatar"
                                android:gravity="center_vertical"
                                android:orientation="horizontal">

                                <com.hjq.shape.view.ShapeTextView
                                    style="@style/TextAppearance.App.Bold"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:drawablePadding="@dimen/dp_3"
                                    android:textColor="@color/white"
                                    android:textSize="@dimen/sp_14"
                                    android:text="Avatar" />

                                <com.google.android.material.imageview.ShapeableImageView
                                    android:id="@+id/siv_avatar"
                                    android:layout_width="@dimen/dp_35"
                                    android:layout_height="@dimen/dp_35"
                                    android:scaleType="centerCrop"
                                    app:shapeAppearance="@style/circleStyle"
                                    android:src="@drawable/iv_avatar"/>

                            </LinearLayout>
                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:id="@+id/ll_birth"
                                android:orientation="horizontal">

                                <com.hjq.shape.view.ShapeTextView
                                    style="@style/TextAppearance.App.Bold"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:drawableStart="@drawable/iv_age"
                                    android:drawablePadding="@dimen/dp_3"
                                    android:textColor="@color/white"
                                    android:textSize="@dimen/sp_14"
                                    android:text="Birth" />

                                <com.hjq.shape.view.ShapeTextView
                                    android:id="@+id/stv_birth"
                                    style="@style/TextAppearance.App.Bold"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:drawableEnd="@drawable/iv_into"
                                    android:drawablePadding="@dimen/dp_3"
                                    android:paddingVertical="@dimen/dp_15"
                                    android:textColor="@color/white_80"
                                    android:textSize="@dimen/sp_14"
                                    tool:text="09/11/2026" />

                            </LinearLayout>

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:id="@+id/ll_constellation"
                                android:orientation="horizontal">

                            <com.hjq.shape.view.ShapeTextView
                                style="@style/TextAppearance.App.Bold"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:drawableStart="@drawable/iv_constellation"
                                android:drawablePadding="@dimen/dp_3"
                                android:textColor="@color/white"
                                android:textSize="@dimen/sp_14"
                                android:text="Constellation" />
                            <com.hjq.shape.view.ShapeTextView
                                android:id="@+id/stv_constellation"
                                style="@style/TextAppearance.App.Bold"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:drawablePadding="@dimen/dp_3"
                                android:paddingVertical="@dimen/dp_15"
                                tool:text="Constellation"
                                android:textColor="@color/white_80"
                                android:textSize="@dimen/sp_14" />

                            </LinearLayout>


                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:id="@+id/ll_height"
                                android:orientation="horizontal">

                            <com.hjq.shape.view.ShapeTextView
                                style="@style/TextAppearance.App.Bold"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:drawableStart="@drawable/iv_height"
                                android:drawablePadding="@dimen/dp_3"
                                android:textColor="@color/white"
                                android:textSize="@dimen/sp_14"
                                android:text="Height" />

                            <com.hjq.shape.view.ShapeTextView
                                android:id="@+id/stv_height"
                                style="@style/TextAppearance.App.Bold"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:drawableEnd="@drawable/iv_into"
                                android:drawablePadding="@dimen/dp_3"
                                android:paddingVertical="@dimen/dp_15"
                                tool:text="178cm"
                                android:textColor="@color/white_80"
                                android:textSize="@dimen/sp_14" />

                            </LinearLayout>


                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:id="@+id/ll_weight"
                                android:orientation="horizontal">

                            <com.hjq.shape.view.ShapeTextView
                                style="@style/TextAppearance.App.Bold"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:drawableStart="@drawable/iv_weight"
                                android:drawablePadding="@dimen/dp_3"
                                android:textColor="@color/white"
                                android:textSize="@dimen/sp_14"
                                android:text="Weight" />
                            <com.hjq.shape.view.ShapeTextView
                                android:id="@+id/stv_weight"
                                style="@style/TextAppearance.App.Bold"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:drawableEnd="@drawable/iv_into"
                                android:drawablePadding="@dimen/dp_3"
                                android:paddingVertical="@dimen/dp_15"
                                tool:text="45kg"
                                android:textColor="@color/white_80"
                                android:textSize="@dimen/sp_14" />

                            </LinearLayout>
                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:id="@+id/ll_profession"
                                android:orientation="horizontal">

                            <com.hjq.shape.view.ShapeTextView
                                style="@style/TextAppearance.App.Bold"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:drawableStart="@drawable/iv_profession"
                                android:drawablePadding="@dimen/dp_3"
                                android:textColor="@color/white"
                                android:textSize="@dimen/sp_14"
                                android:text="Profession" />
                            <com.hjq.shape.view.ShapeTextView
                                android:id="@+id/stv_profession"
                                style="@style/TextAppearance.App.Bold"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:drawableEnd="@drawable/iv_into"
                                android:drawablePadding="@dimen/dp_3"
                                android:paddingVertical="@dimen/dp_15"
                                tool:text="XXXXXX"
                                android:textColor="@color/white_80"
                                android:textSize="@dimen/sp_14" />

                            </LinearLayout>


                        </com.hjq.shape.layout.ShapeLinearLayout>


                        <com.hjq.shape.layout.ShapeLinearLayout
                            android:id="@+id/scl_interest"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:paddingHorizontal="@dimen/dp_10"
                            android:paddingTop="@dimen/dp_10">

                            <TextView
                                style="@style/TextAppearance.App.Bold"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Interests"
                                android:textColor="@color/white"
                                android:textSize="@dimen/sp_18" />


                            <androidx.recyclerview.widget.RecyclerView
                                android:id="@+id/interest_recycler_view"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/dp_6"
                                android:nestedScrollingEnabled="false"
                                tool:itemCount="1" />


                        </com.hjq.shape.layout.ShapeLinearLayout>


                    </com.hjq.shape.layout.ShapeLinearLayout>


                </LinearLayout>


            </androidx.core.widget.NestedScrollView>


        </androidx.constraintlayout.widget.ConstraintLayout>

    </com.yang.lovechat.widget.ErrorReLoadView>


</androidx.constraintlayout.widget.ConstraintLayout>
