<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <com.hjq.shape.layout.ShapeConstraintLayout
        android:id="@+id/scl_notice"
        android:layout_marginHorizontal="@dimen/dp_10"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="@dimen/dp_10"
        app:shape_radius="@dimen/dp_10"
        app:layout_constraintTop_toTopOf="parent"
        android:paddingVertical="@dimen/dp_12"
        android:layout_marginTop="@dimen/dp_10"
        app:shape_solidGradientStartColor="@color/color_4DFF5ACD"
        app:shape_solidGradientEndColor="@color/color_4DFF5ACD"
        app:shape_solidColor="@color/color_4DC76BFF">

        <ImageView
            android:id="@+id/iv_open_notice"
            android:layout_width="@dimen/dp_45"
            android:layout_height="@dimen/dp_45"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            android:src="@drawable/iv_notice" />


        <TextView
            android:id="@+id/tv_enable_notification"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/dp_10"
            android:layout_marginStart="@dimen/dp_6"
            android:ellipsize="end"
            android:singleLine="true"
            android:text="Notification"
            android:textColor="@color/white"
            style="@style/TextAppearance.App.Bold"
            android:textSize="@dimen/sp_14"
            app:layout_constraintStart_toEndOf="@+id/iv_open_notice"
            app:layout_constraintTop_toTopOf="parent" />


        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_3"
            android:layout_marginEnd="@dimen/dp_10"
            android:ellipsize="end"
            android:singleLine="true"
            android:text="Never miss a chat hit"
            android:textColor="@color/white"
            android:textSize="@dimen/sp_12"
            app:layout_constraintEnd_toStartOf="@+id/stv_enable"
            app:layout_constraintStart_toStartOf="@+id/tv_enable_notification"
            app:layout_constraintTop_toBottomOf="@+id/tv_enable_notification" />


        <com.hjq.shape.view.ShapeTextView
            android:id="@+id/stv_enable"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/dp_5"
            android:gravity="center"
            android:paddingHorizontal="@dimen/dp_10"
            android:paddingVertical="@dimen/dp_6"
            android:text="Enable"
            android:textColor="@color/textColor"
            android:textSize="@dimen/sp_12"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/iv_x"
            app:layout_constraintTop_toTopOf="parent"
            app:shape_radius="@dimen/dp_6"
            app:shape_solidColor="@color/white" />

        <ImageView
            android:id="@+id/iv_x"
            android:layout_width="@dimen/dp_30"
            android:layout_height="@dimen/dp_30"
            android:padding="@dimen/dp_2"
            android:src="@drawable/iv_close"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />


    </com.hjq.shape.layout.ShapeConstraintLayout>


    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/top_recycler_view"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toBottomOf="@+id/scl_notice"
        android:overScrollMode="never"
        tools:itemCount="3"
        android:layout_marginTop="@dimen/dp_5"
        android:orientation="horizontal"
        android:visibility="gone"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
        tools:listitem="@layout/item_top_conversation"
        />


    <com.google.android.material.tabs.TabLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:id="@+id/tabLayout"
        android:background="@color/transparent"
        app:tabIndicator="@drawable/layer_list_tab_indicator"
        app:tabIndicatorFullWidth="false"
        app:tabIndicatorColor="@color/color_FF5ACD"
        app:tabMode="scrollable"
        android:visibility="gone"
        app:tabPadding="@dimen/dp_0"
        app:tabRippleColor="@color/transparent"
        app:layout_constraintTop_toBottomOf="@+id/top_recycler_view"/>



    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:id="@+id/mSwipeRefreshLayout"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/dp_10"
        app:layout_constraintTop_toBottomOf="@+id/tabLayout"
        app:layout_constraintBottom_toBottomOf="parent"
        android:overScrollMode="never">


        <com.yang.lovechat.widget.ErrorReLoadView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:id="@+id/errorReLoadView">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recyclerView"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:overScrollMode="never"
                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                tools:listitem="@layout/item_conversation"
                />
        </com.yang.lovechat.widget.ErrorReLoadView>


    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

</androidx.constraintlayout.widget.ConstraintLayout>