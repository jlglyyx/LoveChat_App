<?xml version="1.0" encoding="utf-8"?>
<resources>

    <declare-styleable name="AppToolBar">
        <attr name="title" format="string" />
        <attr name="titleColor" format="reference" />
        <attr name="backImgVisible" format="boolean" />
        <attr name="backImgSrc" format="reference" />
        <attr name="endImgVisible" format="boolean" />
        <attr name="endImgSrc" format="reference" />
        <attr name="toolbarColor" format="reference" />
